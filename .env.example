# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://safi:safipassword@localhost:5432/safi_restaurant
POSTGRES_USER=safi
POSTGRES_PASSWORD=safipassword
POSTGRES_DB=safi_restaurant

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:safiRedisPass@localhost:6379
REDIS_PASSWORD=safiRedisPass

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_choose_any_string
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── File Storage (S3-compatible) ─────────────────────────────────────────────
S3_ENDPOINT=https://your-bucket-endpoint
S3_BUCKET=safi-restaurant
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=ap-south-1
CDN_URL=https://cdn.yourdomain.com

# ─── Payments ─────────────────────────────────────────────────────────────────
# COD only at launch — fill these in when switching on online payments
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
PAYMENT_LINK_EXPIRES_MINUTES=15

# ─── Sentry (error monitoring) ────────────────────────────────────────────────
SENTRY_DSN=

# ─── Email (optional — for owner daily summary) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=
